{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../*"],
      "@flowtrack/shared": ["../../packages/shared/src"],
      "@flowtrack/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "../../src"]
}
