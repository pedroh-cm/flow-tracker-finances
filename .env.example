# Copie para .env.local: cp .env.example .env.local

# Obrigatório em produção — gere com: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# URLs dos microfrontends (Module Federation)
NEXT_PUBLIC_MFE_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_MFE_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_MFE_TRANSACTIONS_URL=http://localhost:3003
NEXT_PUBLIC_MFE_INVESTMENTS_URL=http://localhost:3004

# Descomente para desativar Module Federation e usar componentes locais
# NEXT_PUBLIC_MFE_MODE=local
